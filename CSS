
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #eeeeee;
    color: #222;
}

header {
    background-color: #111;
    color: white;
    text-align: center;
    padding: 40px;
}

header h1 {
    color: #287bdb;
}

nav {
    background-color: #1765b5;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
    font-weight: bold;
}

section {
    background-color: white;
    margin: 25px;
    padding: 25px;
    border-radius: 10px;
}

h2 {
    color: #1765b5;
}

.gallery {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

.gallery div {
    text-align: center;
    width: 300px;
}

.gallery img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 10px;
}

.gallery h3 {
    color: #1765b5;
}

.quote {
    background-color: #111;
    color: white;
    text-align: center;
}

.quote h2 {
    color: #287bdb;
}

footer {
    background-color: #111;
    color: white;
    text-align: center;
    padding: 20px;
}

